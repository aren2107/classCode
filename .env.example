# Copy to .env and replace placeholders. Never commit real credentials.
DISCORD_TOKEN=replace-with-discord-bot-token
GUILD_ID=replace-with-test-server-id

# The Discord bot connects only to Supabase PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Optional AI feedback. Leave blank to use built-in fallback responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Judge0-compatible execution service. Never execute student code in this bot.
CODE_RUNNER_URL=https://ce.judge0.com
CODE_RUNNER_API_KEY=
CODE_RUNNER_AUTH_USER=

# Neon credentials belong only in a separate, explicitly invoked backup/recovery job.

# Migration runner only - never used by the Discord bot.
# Use the direct Supabase database hostname and the official Supabase CA certificate.
CLASSCODE_ENVIRONMENT=staging
STAGING_DATABASE_URL=postgresql://USER:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
STAGING_SSLROOTCERT=C:\path\to\supabase-ca.crt
